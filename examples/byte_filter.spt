// Two RX stages: split raw bytes into pairs, then filter on the first byte.
clock 50 MHz
const BIT = 64 cycles
pin tx: out = sender.out
pin rx: in
timer tx_bit { every: BIT, first: BIT - 2 cycles, pulse, run: sender.busy until sender.done }
shifter sender { frame: [0, data(8), 1], idle: 1, shift: tx_bit.tick }
timer rx_bit { every: BIT, first: BIT / 2 - 1 cycles, pulse, run: rx.fall until receiver.done }
shifter receiver { frame: [0, data(8), 1], start: rx.fall, shift: rx_bit.tick, sample: rx at rx_bit.tick }

export stream send: host -> sender
export packets recv: receiver -> host {
    tag { length: 2 }
    filter { value: 0x20, mask: 0xF0 }
}

test "drop nonmatching packet and retain subsequent addressed packets" {
    wire tx -> rx
    send.write([0x10, 0x01, 0x2F, 0x02, 0x20, 0x03])
    expect recv.read_packet() == packet([0x2F, 0x02], error: 0)
    expect recv.read_packet() == packet([0x20, 0x03], error: 0)
}
