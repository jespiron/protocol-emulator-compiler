clock 50 MHz
const BIT = 64 cycles
pin tx: out = sender.out
pin rx: in
timer tx_bit { every: BIT, first: BIT - 2 cycles, pulse, run: sender.busy until sender.done }
shifter sender { frame: [0, data(8), 1], idle: 1, shift: tx_bit.tick }
timer rx_bit { every: BIT, first: BIT / 2 - 1 cycles, pulse, run: rx.fall until receiver.done }
shifter receiver { frame: [0, data(8), 1], start: rx.fall, shift: rx_bit.tick, sample: rx at rx_bit.tick }

export packets send: host -> sender {
    checksum { algorithm: xor, operation: generate }
    pass {}
}

export packets recv: receiver -> host {
    tag { length: 3 }
    checksum { algorithm: xor, operation: verify }
}

test "independent UART peer sees the XOR checksum" {
    attach uart_device(from_chip: tx, to_chip: rx, bit: BIT) as terminal
    send.write_packet([0x12, 0x34])
    expect terminal.read(3) == [0x12, 0x34, 0x26]
}

test "XOR checksum verifies on receive" {
    wire tx -> rx
    send.write_packet([0x12, 0x34])
    expect recv.read_packet() == packet([0x12, 0x34, 0x26], error: 0)
}
test "bad XOR checksum is reported" {
    attach uart_device(from_chip: tx, to_chip: rx, bit: BIT) as terminal
    wait 100 us
    terminal.write([0x12, 0x34, 0x00])
    expect recv.read_packet() == packet([0x12, 0x34, 0x00], error: 1)
}
