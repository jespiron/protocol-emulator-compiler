// One physical UART shifter, with 8N1 and 8E1 configurations.
clock 50 MHz
const BIT = 64 cycles
pin tx: out = sender.out
pin unused_rx: in
flag use_even = 0

timer bit { every: BIT, first: BIT - 2 cycles, pulse, run: sender.busy until sender.done }
contexts(select: use_even) {
    context 0 {
        pin left: out = 0
        pin right: out = 1
        shifter sender { frame: [0, data(8), 1], idle: 1, shift: bit.tick }
    }
    context 1 {
        pin left: out = 1
        pin right: out = 0
        shifter sender { frame: [0, data(8), even, 1], idle: 1, shift: bit.tick }
    }
}
always "paired pin contexts change together" {
    (left.changed || right.changed) implies left != right
}
export stream send: host -> sender
// Select between complete frames. Contexts change configuration, not tile state.
export fn even_mode() { flags(use_even) }
export fn normal_mode() { flags() }

test "explicit zero initializes 8N1" {
    attach uart_device(from_chip: tx, to_chip: unused_rx, bit: BIT) as terminal
    send.write([0x00, 0x55, 0xFF])
    expect terminal.read(3) == [0x00, 0x55, 0xFF]
}
test "context one selects 8E1 on the same shifter" {
    attach uart_device(from_chip: tx, to_chip: unused_rx, bit: BIT, parity: "even") as terminal
    even_mode()
    send.write([0x00, 0x01, 0xFF])
    expect terminal.read(3) == [0x00, 0x01, 0xFF]
}
test "switch back to context zero" {
    attach uart_device(from_chip: tx, to_chip: unused_rx, bit: BIT) as terminal
    even_mode()
    normal_mode()
    send.write([0x00, 0xAA, 0xFF])
    expect terminal.read(3) == [0x00, 0xAA, 0xFF]
}
